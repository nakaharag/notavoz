# Authentication
# Usuario inicial, criado no banco so se ainda nao existir (8+ caracteres). Mais contas: ver docs/PILOT-HANDOFF.md
SEED_USERNAME=
SEED_PASSWORD=
JWT_SECRET=

# OpenAI API
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini

# Domains for the production Compose file
NOTAVOZ_DOMAIN=piloto.example.com

# Settings for the legacy Coolify Compose file
REACT_APP_API_URL=https://api.notavoz.com.br
CORS_ORIGIN=https://notavoz.com.br,https://www.notavoz.com.br

# Use a unique tag for each release; keep the previous images for rollback
RELEASE_TAG=pilot-v1
